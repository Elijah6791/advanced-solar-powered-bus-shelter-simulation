<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Bus Stop Dashboard - Fairfield</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-dark: #0f172a;
            --panel-bg: #1e293b;
            --accent-blue: #38bdf8;
            --accent-green: #22c55e;
            --accent-orange: #f97316;
            --text-light: #f8fafc;
            --text-muted: #94a3b8;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            margin: 0;
            padding: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 25px;
            padding: 20px;
            background: var(--panel-bg);
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3);
            border-bottom: 3px solid var(--accent-blue);
        }

        .header h1 {
            margin: 0 0 5px 0;
            color: var(--accent-blue);
            font-size: 1.8rem;
        }

        .header p {
            margin: 0 0 10px 0;
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .team-badge {
            display: inline-block;
            background: #0f172a;
            color: var(--accent-green);
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            border: 1px solid #334155;
        }

        .controls-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--panel-bg);
            padding: 12px 20px;
            border-radius: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .grid-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 20px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .card {
            background: var(--panel-bg);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.3);
            position: relative;
        }

        .card h2 {
            margin-top: 0;
            color: var(--accent-blue);
            font-size: 1.2rem;
            border-bottom: 1px solid #334155;
            padding-bottom: 10px;
        }

        .function-desc {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 12px;
            background: #0f172a;
            padding: 8px;
            border-radius: 6px;
            border-left: 3px solid var(--accent-orange);
        }

        .stat-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 15px;
        }

        .stat-box {
            background: #0f172a;
            padding: 12px;
            border-radius: 8px;
            border-left: 4px solid var(--accent-blue);
        }

        .stat-box.green { border-left-color: var(--accent-green); }
        .stat-box.orange { border-left-color: var(--accent-orange); }

        .stat-value {
            font-size: 1.3rem;
            font-weight: bold;
        }

        .stat-label {
            font-size: 0.78rem;
            color: var(--text-muted);
        }

        /* SVG Inspector Container */
        .diagram-container {
            position: relative;
            width: 100%;
            height: 290px;
            background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1px solid #334155;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
        }

        .hotspot {
            position: absolute;
            width: 26px;
            height: 26px;
            background: var(--accent-blue);
            color: #0f172a;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            box-shadow: 0 0 12px var(--accent-blue);
            border: 2px solid #ffffff;
            transition: all 0.2s ease-in-out;
            z-index: 10;
        }

        .hotspot:hover {
            transform: scale(1.3);
            background: var(--accent-green);
            box-shadow: 0 0 16px var(--accent-green);
        }

        .location-select {
            width: 100%;
            padding: 10px;
            background: #0f172a;
            color: var(--text-light);
            border: 1px solid #334155;
            border-radius: 6px;
            margin-bottom: 12px;
            font-size: 0.9rem;
        }

        .calc-input {
            margin-bottom: 10px;
        }

        .calc-input label {
            display: block;
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 3px;
        }

        .calc-input input {
            width: 100%;
            padding: 8px;
            background: #0f172a;
            border: 1px solid #334155;
            color: #fff;
            border-radius: 4px;
            box-sizing: border-box;
        }

        .btn {
            background: var(--accent-blue);
            color: #000;
            border: none;
            padding: 8px 14px;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
        }

        .btn:hover { opacity: 0.9; }

        .info-panel {
            background: #0f172a;
            padding: 14px;
            border-radius: 8px;
            font-size: 0.88rem;
            line-height: 1.45;
            min-height: 65px;
            border: 1px solid #334155;
        }

        .bus-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .bus-item {
            display: flex;
            justify-content: space-between;
            padding: 7px 0;
            border-bottom: 1px solid #334155;
            font-size: 0.88rem;
        }

        .qa-item {
            margin-bottom: 10px;
            font-size: 0.85rem;
            background: #0f172a;
            padding: 10px;
            border-radius: 6px;
            border-left: 3px solid var(--accent-green);
        }

        .qa-question {
            font-weight: bold;
            color: var(--accent-green);
            margin-bottom: 3px;
        }

        /* AI Assistant Box */
        .ai-chat-box {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 8px;
            height: 220px;
            overflow-y: auto;
            padding: 12px;
            font-size: 0.85rem;
            margin-bottom: 10px;
            display: flex;
            flex-col;
            gap: 10px;
        }

        .msg {
            padding: 8px 12px;
            border-radius: 8px;
            max-width: 85%;
            line-height: 1.4;
            margin-bottom: 8px;
        }

        .msg.user {
            background: #0284c7;
            color: #fff;
            align-self: flex-end;
            margin-left: auto;
        }

        .msg.ai {
            background: #1e293b;
            color: #f8fafc;
            border: 1px solid #334155;
            align-self: flex-start;
        }

        .preset-btn {
            background: #1e293b;
            border: 1px solid #38bdf8;
            color: #38bdf8;
            padding: 5px 10px;
            font-size: 0.75rem;
            border-radius: 15px;
            cursor: pointer;
            margin-right: 5px;
            margin-bottom: 5px;
            transition: all 0.2s;
        }

        .preset-btn:hover {
            background: #38bdf8;
            color: #0f172a;
        }

        .kiosk-mode .controls-bar { display: none; }
    </style>
</head>
<body>

    <div class="header">
        <h1>Fairfield Smart Solar & Wind Bus Shelter</h1>
        <p>Interactive System Model, Live Energy Performance & Infrastructure Dashboard</p>
        <div class="team-badge">Project Creators: Elijah, Yousif, Yamen & Caleb</div>
    </div>

    <div class="controls-bar">
        <div>
            <strong style="font-size: 0.9rem; color: var(--accent-blue);">Weather Simulator:</strong>
            <button class="btn" style="background:#f97316; color:#fff; margin-left:8px;" onclick="setWeather('sunny')">Sunny Summer</button>
            <button class="btn" style="background:#64748b; color:#fff; margin-left:5px;" onclick="setWeather('overcast')">Overcast Winter</button>
            <button class="btn" style="background:#22c55e; color:#fff; margin-left:5px;" onclick="setWeather('storm')">Stormy Night</button>
        </div>
        <div>
            <button class="btn" style="background:#22c55e; color:#000;" onclick="toggleKioskMode()">Toggle Kiosk Display Mode</button>
        </div>
    </div>

    <div class="grid-container">

        <!-- Card 1: Real-Time Energy Generation & Dynamic Chart -->
        <div class="card">
            <h2>1. Live Energy Generation & Carbon Offset</h2>
            <div class="function-desc">
                <strong>What this does:</strong> Displays real-time power generation from solar and wind inputs, tracking battery reserves and total CO2 reduction.
            </div>
            <div class="stat-grid">
                <div class="stat-box orange">
                    <div class="stat-label">Solar Output</div>
                    <div class="stat-value" id="solar-val">380 W</div>
                </div>
                <div class="stat-box blue">
                    <div class="stat-label">Wind Turbine</div>
                    <div class="stat-value" id="wind-val">70 W</div>
                </div>
                <div class="stat-box green">
                    <div class="stat-label">Daily CO2 Offset</div>
                    <div class="stat-value" id="co2-val">1.8 kg</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">LiFePO4 Battery</div>
                    <div class="stat-value" style="color: var(--accent-green);" id="batt-val">94%</div>
                </div>
            </div>
            <canvas id="energyChart" height="160"></canvas>
        </div>

        <!-- Card 2: High-Detail Architectural Model Inspector -->
        <div class="card">
            <h2>2. Structural Component Inspector</h2>
            <div class="function-desc">
                <strong>What this does:</strong> Click numbered pins on the schematic model to inspect hardware specs, energy outputs, and maintenance lifespans.
            </div>
            <div class="diagram-container">
                <svg width="340" height="240" viewBox="0 0 340 240">
                    <defs>
                        <linearGradient id="glassGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.3"/>
                            <stop offset="100%" stop-color="#0f172a" stop-opacity="0.05"/>
                        </linearGradient>
                    </defs>

                    <!-- Concrete Base -->
                    <rect x="20" y="215" width="300" height="14" fill="#334155" rx="3"/>
                    
                    <!-- Vertical Steel Support Columns -->
                    <rect x="50" y="70" width="10" fill="#64748b" height="145" rx="2"/>
                    <rect x="270" y="70" width="10" fill="#64748b" height="145" rx="2"/>
                    <rect x="160" y="70" width="6" fill="#475569" height="145"/>

                    <!-- Back Safety Glass Panel -->
                    <rect x="55" y="80" width="220" height="135" fill="url(#glassGrad)" stroke="#38bdf8" stroke-width="1.5" rx="4"/>

                    <!-- Bench Structure -->
                    <rect x="80" y="172" width="160" height="10" fill="#94a3b8" rx="2"/>
                    <rect x="95" y="182" width="8" fill="#64748b" height="33"/>
                    <rect x="225" y="182" width="8" fill="#64748b" height="33"/>

                    <!-- Roof Canopy Frame -->
                    <polygon points="30,70 300,70 290,60 40,60" fill="#475569"/>

                    <!-- Rooftop Monocrystalline Solar Array -->
                    <polygon points="45,58 285,58 275,44 55,44" fill="#f97316"/>
                    <line x1="115" y1="44" x2="120" y2="58" stroke="#ea580c" stroke-width="1.5"/>
                    <line x1="165" y1="44" x2="165" y2="58" stroke="#ea580c" stroke-width="1.5"/>
                    <line x1="215" y1="44" x2="210" y2="58" stroke="#ea580c" stroke-width="1.5"/>

                    <!-- Vertical Micro Wind Turbine -->
                    <line x1="265" y1="44" x2="265" y2="15" stroke="#cbd5e1" stroke-width="3"/>
                    <circle cx="265" cy="18" r="13" fill="none" stroke="#22c55e" stroke-width="2.5"/>
                    <ellipse cx="265" cy="18" rx="4" ry="12" fill="#22c55e"/>

                    <!-- Battery Storage Enclosure (IP65) -->
                    <rect x="62" y="165" width="28" height="48" fill="#1e293b" stroke="#22c55e" stroke-width="2" rx="3"/>
                    <circle cx="76" cy="175" r="3" fill="#22c55e"/>
                    <line x1="68" y1="185" x2="84" y2="185" stroke="#475569" stroke-width="2"/>
                    <line x1="68" y1="193" x2="84" y2="193" stroke="#475569" stroke-width="2"/>

                    <!-- Overhead LED Light Strip & Screen -->
                    <rect x="70" y="72" width="180" height="4" fill="#f8fafc"/>
                    <rect x="190" y="90" width="75" height="42" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5" rx="3"/>
                    <line x1="196" y1="102" x2="245" y2="102" stroke="#38bdf8" stroke-width="2"/>
                    <line x1="196" y1="114" x2="230" y2="114" stroke="#22c55e" stroke-width="2"/>
                </svg>

                <div class="hotspot" style="top: 35px; left: 145px;" onclick="showInfo('solar')">1</div>
                <div class="hotspot" style="top: 10px; right: 55px;" onclick="showInfo('wind')">2</div>
                <div class="hotspot" style="bottom: 35px; left: 62px;" onclick="showInfo('battery')">3</div>
                <div class="hotspot" style="bottom: 50px; left: 155px;" onclick="showInfo('seating')">4</div>
                <div class="hotspot" style="top: 75px; left: 110px;" onclick="showInfo('lights')">5</div>
            </div>
            <br>
            <div class="info-panel" id="info-display">
                Click any numbered hotspot on the bus shelter model above to review detailed engineering rationale and lifespan metrics.
            </div>
        </div>

        <!-- Card 3: Location & Seating -->
        <div class="card">
            <h2>3. Fairfield Deployment & Transit Timetable</h2>
            <div class="function-desc">
                <strong>What this does:</strong> Switches between key Fairfield hubs to display passenger capacity (4 seated, 6-8 standing) and live bus arrivals.
            </div>
            <select class="location-select" id="location-select" onchange="updateLocation()">
                <option value="interchange">Fairfield Station Interchange (The Crescent)</option>
                <option value="suburban">Suburban Route (The Horsley Drive)</option>
                <option value="showground">Fairfield Showground (Smithfield Rd)</option>
            </select>

            <div class="stat-grid">
                <div class="stat-box">
                    <div class="stat-label">Seating Capacity</div>
                    <div class="stat-value" id="seat-cap">4 Seated</div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">Standing Cover</div>
                    <div class="stat-value" id="stand-cap">6-8 People</div>
                </div>
            </div>

            <div class="info-panel" style="margin-bottom: 10px;" id="loc-info">
                <strong>Location Notes:</strong> High commuter density at Fairfield Station (The Crescent). Maximum ad revenue exposure.
            </div>

            <h3 style="font-size: 0.85rem; color: var(--accent-blue); margin-bottom: 5px;">Live Bus Arrivals</h3>
            <ul class="bus-list" id="bus-list">
                <li class="bus-item"><span>804 to Parramatta</span> <strong>4 mins</strong></li>
                <li class="bus-item"><span>808 to Liverpool</span> <strong>9 mins</strong></li>
                <li class="bus-item"><span>817 to Cabramatta</span> <strong>15 mins</strong></li>
            </ul>
        </div>

        <!-- Card 4: ROI & Ad Revenue Calculator -->
        <div class="card">
            <h2>4. Financial ROI & Advertising Payback</h2>
            <div class="function-desc">
                <strong>What this does:</strong> Calculates net maintenance costs ($1,000/yr) and payback period offset by digital ad displays.
            </div>
            <div class="calc-input">
                <label>Initial Shelter CapEx ($):</label>
                <input type="number" id="capex" value="28000" oninput="calculateROI()">
            </div>
            <div class="calc-input">
                <label>Annual Maintenance Fee ($):</label>
                <input type="number" id="maint" value="1000" oninput="calculateROI()">
            </div>
            <div class="calc-input">
                <label>Est. Annual Digital Ad Revenue ($):</label>
                <input type="number" id="adrev" value="2500" oninput="calculateROI()">
            </div>

            <div class="stat-grid" style="margin-top:10px;">
                <div class="stat-box green">
                    <div class="stat-label">Net Annual Income</div>
                    <div class="stat-value" id="net-income">$1,500/yr</div>
                </div>
                <div class="stat-box orange">
                    <div class="stat-label">Payback Period</div>
                    <div class="stat-value" id="payback">18.6 yrs</div>
                </div>
            </div>
        </div>

        <!-- Card 5: Smart AI Chat Assistant powered by Gemini API -->
        <div class="card" style="grid-column: 1 / -1;">
            <h2>5. Live Gemini AI Presentation Assistant</h2>
            <div class="function-desc">
                <strong>What this does:</strong> Powered by Gemini 3 Flash. Evaluators can ask any custom question about Elijah, Yousif, Yamen & Caleb's project and get instant, intelligent, natural answers!
            </div>
            
            <div style="margin-bottom: 10px;">
                <button class="preset-btn" onclick="askPreset('How does this shelter handle 3 straight days of cloudy winter weather?')">Cloudy Weather Handling</button>
                <button class="preset-btn" onclick="askPreset('Can you break down the financial ROI and ad revenue for Fairfield Council?')">Ad ROI & Financials</button>
                <button class="preset-btn" onclick="askPreset('Why combine wind and solar instead of using just solar panels?')">Solar vs Wind Rationale</button>
                <button class="preset-btn" onclick="askPreset('What is the maintenance schedule and lifespan for each component?')">Lifespans & Maintenance</button>
                <button class="preset-btn" onclick="askPreset('How does this design address passenger safety and vandalism?')">Safety & Anti-Vandalism</button>
            </div>

            <div class="ai-chat-box" id="ai-chat-box">
                <div class="msg ai">
                    <strong>Smart Shelter AI (Gemini 3 Flash):</strong> Hello! I am your live presentation AI grounded in Elijah, Yousif, Yamen, and Caleb's Smart Bus Shelter project for Fairfield. Ask me anything about solar/wind output, battery reserves, ROI, or urban deployment!
                </div>
            </div>

            <div style="display: flex; gap: 10px;">
                <input type="text" id="ai-input" placeholder="Ask Gemini any question about the project (e.g. How does the hybrid energy system work?)..." style="flex:1; padding: 10px; background: #0f172a; border: 1px solid #334155; color:#fff; border-radius:6px; font-size: 0.85rem;" onkeypress="if(event.key==='Enter') sendAIQuery()">
                <button class="btn" style="background: var(--accent-blue);" id="ai-send-btn" onclick="sendAIQuery()">Ask Gemini</button>
            </div>
        </div>

    </div>

    <script>
        // Weather Datasets for Dynamic Chart Updates
        const weatherConfigs = {
            sunny: {
                solar: [40, 210, 420, 310, 90, 0],
                wind: [40, 35, 40, 45, 50, 40],
                solarVal: "420 W",
                windVal: "40 W",
                co2Val: "2.1 kg",
                battVal: "98%"
            },
            overcast: {
                solar: [10, 45, 90, 60, 15, 0],
                wind: [50, 55, 60, 65, 70, 60],
                solarVal: "90 W",
                windVal: "60 W",
                co2Val: "0.9 kg",
                battVal: "72%"
            },
            storm: {
                solar: [0, 0, 0, 0, 0, 0],
                wind: [180, 220, 250, 280, 240, 200],
                solarVal: "0 W",
                windVal: "280 W",
                co2Val: "1.5 kg",
                battVal: "88%"
            }
        };

        let energyChart;

        window.onload = function() {
            initChart();
        };

        function initChart() {
            const ctx = document.getElementById('energyChart').getContext('2d');
            energyChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['6am', '9am', '12pm', '3pm', '6pm', '9pm'],
                    datasets: [{
                        label: 'Solar Output (W)',
                        data: weatherConfigs.sunny.solar,
                        borderColor: '#f97316',
                        backgroundColor: 'rgba(249, 115, 22, 0.15)',
                        borderWidth: 3,
                        tension: 0.35,
                        fill: true
                    }, {
                        label: 'Wind Turbine (W)',
                        data: weatherConfigs.sunny.wind,
                        borderColor: '#22c55e',
                        backgroundColor: 'rgba(34, 197, 94, 0.15)',
                        borderWidth: 3,
                        tension: 0.35,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { 
                        legend: { labels: { color: '#f8fafc', boxWidth: 14 } } 
                    },
                    scales: {
                        x: { 
                            ticks: { color: '#94a3b8' }, 
                            grid: { color: '#334155' },
                            title: { display: true, text: 'Time of Day (24-Hr Cycle)', color: '#38bdf8', font: { size: 11, weight: 'bold' } }
                        },
                        y: { 
                            ticks: { color: '#94a3b8' }, 
                            grid: { color: '#334155' },
                            title: { display: true, text: 'Power Output (Watts - W)', color: '#38bdf8', font: { size: 11, weight: 'bold' } },
                            min: 0,
                            max: 450
                        }
                    }
                }
            });
        }

        // Weather Simulator with Dynamic Graph Animations
        function setWeather(mode) {
            const config = weatherConfigs[mode];

            document.getElementById('solar-val').innerText = config.solarVal;
            document.getElementById('wind-val').innerText = config.windVal;
            document.getElementById('co2-val').innerText = config.co2Val;
            document.getElementById('batt-val').innerText = config.battVal;

            if (energyChart) {
                energyChart.data.datasets[0].data = config.solar;
                energyChart.data.datasets[1].data = config.wind;
                energyChart.update();
            }
        }

        function toggleKioskMode() {
            document.body.classList.toggle('kiosk-mode');
        }

        function showInfo(type) {
            const info = document.getElementById('info-display');
            if(type === 'solar') {
                info.innerHTML = "<strong>1. Rooftop Monocrystalline Solar Array (400W):</strong><br>Generates ~1.5 - 2.0 kWh daily. Built with tempered solar glass. <strong>Lifespan: 25+ years</strong>.";
            } else if(type === 'wind') {
                info.innerHTML = "<strong>2. Vertical Axis Wind Turbine:</strong><br>Omni-directional micro turbine capturing urban wind gusts (~0.4 kWh daily). <strong>Lifespan: 15-20 years</strong>.";
            } else if(type === 'battery') {
                info.innerHTML = "<strong>3. LiFePO4 Battery Storage (2.5 kWh):</strong><br>Deep-cycle battery enclosure with MPPT controller. Requires replacement every <strong>7-10 years</strong>.";
            } else if(type === 'seating') {
                info.innerHTML = "<strong>4. Integrated Seating (4 capacity):</strong><br>Recycled aluminum and timber composite bench designed for weather resistance and shade management.";
            } else if(type === 'lights') {
                info.innerHTML = "<strong>5. LED Lighting & Timetable Panel:</strong><br>Low-draw 12V LED light bar, USB charger ports, and live transit screen. Maintenance cycle: <strong>7-10 years</strong>.";
            }
        }

        function updateLocation() {
            const loc = document.getElementById('location-select').value;
            const info = document.getElementById('loc-info');
            const buses = document.getElementById('bus-list');

            if(loc === 'interchange') {
                info.innerHTML = "<strong>Location Notes:</strong> High commuter density at Fairfield Station (The Crescent). Maximum ad revenue exposure.";
                buses.innerHTML = `
                    <li class="bus-item"><span>804 to Parramatta</span> <strong>4 mins</strong></li>
                    <li class="bus-item"><span>808 to Liverpool</span> <strong>9 mins</strong></li>
                    <li class="bus-item"><span>817 to Cabramatta</span> <strong>15 mins</strong></li>`;
            } else if(loc === 'suburban') {
                info.innerHTML = "<strong>Location Notes:</strong> Residential neighborhood stop along The Horsley Drive. Off-grid solar/wind powers security lighting.";
                buses.innerHTML = `
                    <li class="bus-item"><span>800 to Fairfield</span> <strong>12 mins</strong></li>
                    <li class="bus-item"><span>800 to Blacktown</span> <strong>22 mins</strong></li>`;
            } else if(loc === 'showground') {
                info.innerHTML = "<strong>Location Notes:</strong> Smithfield Road hub. High weekend event traffic requiring robust public safety lighting and CCTV.";
                buses.innerHTML = `
                    <li class="bus-item"><span>812 to Fairfield</span> <strong>7 mins</strong></li>
                    <li class="bus-item"><span>813 to Bonnyrigg</span> <strong>18 mins</strong></li>`;
            }
        }

        function calculateROI() {
            const capex = parseFloat(document.getElementById('capex').value) || 0;
            const maint = parseFloat(document.getElementById('maint').value) || 0;
            const adrev = parseFloat(document.getElementById('adrev').value) || 0;

            const net = adrev - maint;
            document.getElementById('net-income').innerText = "$" + net.toLocaleString() + "/yr";

            if(net > 0) {
                const payback = (capex / net).toFixed(1);
                document.getElementById('payback').innerText = payback + " yrs";
            } else {
                document.getElementById('payback').innerText = "N/A";
            }
        }

        // Live Gemini API AI Integration
        const SYSTEM_PROMPT = `You are the official Smart Shelter AI Assistant presenting on behalf of Elijah, Yousif, Yamen, and Caleb for their Fairfield Energy-Efficient Smart Bus Shelter project.
You respond in a friendly, professional, confident, and direct conversational tone—just like an expert engineering assistant presenting to school evaluators, teachers, or Fairfield City Council members.

KEY PROJECT FACTS TO REMEMBER:
- Team Members: Elijah, Yousif, Yamen, and Caleb.
- Location Target: Fairfield, NSW (Interchange at The Crescent, The Horsley Drive, and Fairfield Showground).
- Energy System: Solar (400W rooftop array) combined with a Vertical Axis Micro-Wind Turbine. Hybrid energy ensures 24/7 power day and night.
- Storage: 2.5 kWh LiFePO4 deep-cycle battery with 48 hours (2 full days) of off-grid backup.
- Lifespans: 25+ years for steel frame/solar panels; 7-10 years for battery, LEDs, and digital timetable screens.
- Financials: CapEx = ~$28,000. Annual Maintenance = $1,000/yr. Digital Ad Display Revenue = ~$2,500/yr. Net annual revenue = $1,500/yr. Payback period = ~18.6 years.
- Capacity: 4 seated passengers, 6-8 standing under covered roof canopy.
- Security & Durability: IP65 waterproof, 10mm anti-vandal polycarbonate glass, low-draw 12V LED lighting, USB charging, CCTV camera security.
- Data Integration: Mock GTFS real-time transit timetables (Transport for NSW live API ready).

Keep answers clear, concise (2-4 sentences max per response unless asked for detailed breakdowns), encouraging, and impressive for evaluators.`;

        function askPreset(qText) {
            document.getElementById('ai-input').value = qText;
            sendAIQuery();
        }

        async function sendAIQuery() {
            const input = document.getElementById('ai-input');
            const userText = input.value.trim();
            if(!userText) return;

            const box = document.getElementById('ai-chat-box');
            const sendBtn = document.getElementById('ai-send-btn');

            // 1. Render User Question
            const userMsg = document.createElement('div');
            userMsg.className = 'msg user';
            userMsg.innerText = userText;
            box.appendChild(userMsg);

            input.value = '';
            box.scrollTop = box.scrollHeight;

            // 2. Render Loading Indicator
            const loadingMsg = document.createElement('div');
            loadingMsg.className = 'msg ai';
            loadingMsg.id = 'ai-loading-msg';
            loadingMsg.innerHTML = `<strong>Smart Shelter AI:</strong> <em>Thinking...</em>`;
            box.appendChild(loadingMsg);
            box.scrollTop = box.scrollHeight;
            sendBtn.disabled = true;

            // 3. Call Gemini 3 Flash API
            try {
                const apiKey = ""; // Runtime automatically injected by environment
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

                const payload = {
                    contents: [{
                        role: "user",
                        parts: [{ text: `User Question: "${userText}"` }]
                    }],
                    systemInstruction: {
                        parts: [{ text: SYSTEM_PROMPT }]
                    }
                };

                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                const aiText = data.candidates?.[0]?.content?.parts?.[0]?.text || 
                    "I'm ready to answer any questions about Elijah, Yousif, Yamen, and Caleb's smart bus shelter design, energy metrics, or ROI!";

                loadingMsg.innerHTML = `<strong>Smart Shelter AI:</strong> ` + aiText.replace(/\n/g, '<br>');
            } catch (err) {
                loadingMsg.innerHTML = `<strong>Smart Shelter AI:</strong> Our hybrid energy shelter combines a 400W rooftop solar panel, vertical wind turbine, and a 2.5 kWh LiFePO4 battery providing 48 hours of backup energy with an 18.6-year financial payback via digital ad revenue!`;
            } finally {
                sendBtn.disabled = false;
                box.scrollTop = box.scrollHeight;
            }
        }
    </script>
</body>
</html>
